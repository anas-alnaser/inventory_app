rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user document
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null ? userDoc.data : null;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && 
        getUserData() != null && 
        getUserData().role == role;
    }
    
    // Helper function to check if user is admin or owner (full access)
    function isAdminOrOwner() {
      return hasRole('admin') || hasRole('owner');
    }
    
    // Helper function to check if user is admin, owner, or manager
    function isAdminOrManager() {
      return hasRole('admin') || hasRole('owner') || hasRole('manager');
    }
    
    // Helper function to check if user can manage stock
    function canManageStock() {
      return isAdminOrManager() || hasRole('stock_keeper');
    }
    
    // Helper function to check if user is a store device
    function isStoreDevice() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null && userDoc.data.is_store_device == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read their own profile
      // Admin/Owner can read all users
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdminOrOwner()
      );
      // Users can create their own document (for auto-sync on login)
      // Admin/Owner can create any user
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdminOrOwner()
      );
      // Users can update their own profile, BUT cannot change the role field
      // Only Admin/Owner can modify the role field
      // Admin/Owner can update any user
      allow update: if isAuthenticated() && (
        isAdminOrOwner() ||
        (request.auth.uid == userId && 
         (!('role' in request.resource.data) || 
          request.resource.data.role == resource.data.role))
      );
      // Only Admin/Owner can delete users
      allow delete: if isAdminOrOwner();
    }
    
    // Suppliers collection
    match /suppliers/{supplierId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update
      allow create, update: if isAdminOrManager();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Ingredients collection
    match /ingredients/{ingredientId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update
      allow create, update: if isAdminOrManager();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Ingredient Stock collection
    match /ingredient_stock/{stockId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Stock keepers and above can create/update
      // Also allow authenticated users to create/update for sales and usage/waste (quantity can decrease or be negative)
      // Validate that quantity is a number
      allow create: if isAuthenticated() && 
        request.resource.data.quantity is number;
      allow update: if isAuthenticated() && 
        request.resource.data.quantity is number &&
        // Allow updates if:
        // - Quantity is decreasing (sales, usage, waste) OR
        // - User can manage stock (can increase for restocking)
        (!resource.exists || request.resource.data.quantity <= resource.data.quantity || canManageStock());
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Stock Logs collection
    match /stock_logs/{logId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Allow authenticated users to create logs for:
      // - Sales (reason == 'sale')
      // - Usage/waste reasons (consumption, waste, expired, adjustment, correction)
      // - Stock keepers and above can create any log
      allow create: if isAuthenticated() && 
        (request.resource.data.reason == 'sale' || 
         request.resource.data.reason == 'consumption' ||
         request.resource.data.reason == 'waste' ||
         request.resource.data.reason == 'expired' ||
         request.resource.data.reason == 'adjustment' ||
         request.resource.data.reason == 'correction' ||
         canManageStock());
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Menu Items collection
    match /menu_items/{menuItemId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update
      allow create, update: if isAdminOrManager();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Menu Item Ingredients collection
    match /menu_item_ingredients/{itemId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update/delete
      allow create, update, delete: if isAdminOrManager();
    }
    
    // Purchase Orders collection
    match /purchase_orders/{orderId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update
      allow create, update: if isAdminOrManager();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
      
      // Purchase Order Items subcollection
      match /purchase_order_items/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrManager();
        allow delete: if isAdminOrOwner();
      }
    }
    
    // POS Orders collection
    match /pos_orders/{orderId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update
      allow create, update: if isAdminOrManager();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
      
      // POS Order Items subcollection
      match /pos_order_items/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrManager();
        allow delete: if isAdminOrOwner();
      }
      
      // Payments subcollection
      match /payments/{paymentId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrManager();
        allow update, delete: if isAdminOrOwner();
      }
    }
    
    // Forecasts collection
    match /forecasts/{forecastId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // System/AI can create
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Waste Predictions collection
    match /waste_predictions/{predictionId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // System/AI can create
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Anomalies collection
    match /anomalies/{anomalyId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // System can create
      allow create: if isAuthenticated();
      // Users can update (mark as resolved), Admin/Owner can delete
      allow update: if isAuthenticated();
      allow delete: if isAdminOrOwner();
    }
    
    // Vision Snapshots collection
    match /vision_snapshots/{snapshotId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Stock keepers and above can create
      allow create: if canManageStock();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Analytics Cache collection
    match /analytics_cache/{cacheId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // System can create/update
      allow create, update: if isAuthenticated();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // System Logs collection
    match /system_logs/{logId} {
      // Only Admin/Owner/Manager can read
      allow read: if isAdminOrManager();
      // System can create
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Restaurants collection
    match /restaurants/{restaurantId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Admin/Owner/Manager can create/update
      allow create, update: if isAdminOrManager();
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Invoices collection
    match /invoices/{invoiceId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // All authenticated users can create (for POS sales)
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Shifts collection
    match /shifts/{shiftId} {
      // Users can read their own shifts, admins/owners can read all
      // Store devices can read shifts for any staff member
      allow read: if isAuthenticated() && (
        resource.data.staffId == request.auth.uid ||
        isAdminOrOwner() ||
        isStoreDevice()
      );
      // Authenticated users can create shifts for themselves
      // Store devices can create shifts for any staff member
      allow create: if isAuthenticated() && (
        request.resource.data.staffId == request.auth.uid ||
        isStoreDevice()
      );
      // Users can update their own open shifts, admins/owners can update any
      // Store devices can update shifts for any staff member
      allow update: if isAuthenticated() && (
        isAdminOrOwner() ||
        (resource.data.staffId == request.auth.uid && 
         resource.data.status == 'open') ||
        (isStoreDevice() && resource.data.status == 'open')
      );
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Attendance collection
    match /attendance/{attendanceId} {
      // Users can read their own attendance, admins/owners can read all
      allow read: if isAuthenticated() && (
        resource.data.staffId == request.auth.uid ||
        isAdminOrOwner() ||
        isStoreDevice()
      );
      // Authenticated users can create attendance records for themselves
      // Store devices can create attendance for any staff member
      allow create: if isAuthenticated() && (
        request.resource.data.staffId == request.auth.uid ||
        isStoreDevice()
      );
      // Users can update their own active attendance (no clockOut), admins/owners can update any
      // Store devices can update attendance for any staff member
      allow update: if isAuthenticated() && (
        isAdminOrOwner() ||
        (resource.data.staffId == request.auth.uid &&
         resource.data.clockOut == null) ||
        (isStoreDevice() && resource.data.clockOut == null)
      );
      // Only Admin/Owner can delete
      allow delete: if isAdminOrOwner();
    }
    
    // Hold Orders collection (for holding POS orders)
    match /hold_orders/{orderId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // All authenticated users can create (for POS)
      allow create: if isAuthenticated();
      // All authenticated users can update/delete (recall orders)
      allow update, delete: if isAuthenticated();
    }
    
    // EOD Reports collection
    match /eod_reports/{reportId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // All authenticated users can create (generate reports)
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Refunds collection
    match /refunds/{refundId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // All authenticated users can create (process refunds)
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
    
    // Drawer Events collection (cash drawer operations)
    match /drawer_events/{eventId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // All authenticated users can create (cash drawer operations)
      allow create: if isAuthenticated();
      // Only Admin/Owner can update/delete
      allow update, delete: if isAdminOrOwner();
    }
  }
}
